// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "err_trace",
    "build":  {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "ghcr.io/thecbah/ocaml-features/ocaml:1": {
            "version": "${localEnv:OCAML_VERSION}",
            "packages": "ocamlformat#0.28.1 ppx_expect mdx js_of_ocaml-compiler js_of_ocaml-ppx",
            "optional-packages": "melange",
            "options": "ocaml-option-static",
            "system-packages": "musl-dev musl-tools",
            "ocaml-version-overrides": "pp#1.2.0@4.12.* yojson#2.2.2@4.12.*"
        },
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": {
        "opam": "sudo .devcontainer/fix-opam-owner.sh $(id -u) $(id -g)"
    },
    "waitFor": "postCreateCommand"
}
